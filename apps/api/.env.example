# NutriCl\u00ednica API \u2014 entorno de desarrollo
# Copia este archivo a `.env` y completa los valores

PORT=3000
NODE_ENV=development

# SQL Server (local)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=nutriclinica
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Auth
JWT_SECRET=replace-with-32+-chars-random-string
JWT_EXPIRES_IN=12h
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
