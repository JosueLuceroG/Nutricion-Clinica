# =====================================================================
# NutriClinica API — variables de entorno
# Copia este archivo a .env y rellena los valores para tu entorno local.
# =====================================================================

# --- Server ---
PORT=3000
API_BIND_HOST=127.0.0.1
NODE_ENV=development
# URLs públicas no secretas. STAGING/PRODUCTION exigen HTTPS remoto.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:1420
# false en acceso directo local. Detrás de edge usar saltos acotados (p.ej. 1)
# o lista IP/CIDR explícita; true/*/0.0.0.0/0 se rechazan.
TRUST_PROXY=false
# Mantiene comportamiento histórico local. En despliegue canónico: false en
# procesos API y true únicamente en un runner jobs dedicado.
BACKGROUND_JOBS_ENABLED=true
# Missing values default safely to one. STAGING/PRODUCTION reject either value
# above one until multi-replica operation is certified.
API_REPLICAS=1
JOBS_REPLICAS=1
SHUTDOWN_TIMEOUT_MS=15000

# --- SQL Server ---
# Para SQL Server local con instancia nombrada usa: localhost\SQLEXPRESS
# Para instancia default (MSSQLSERVER) usa: localhost
#
# Dos modos de auth:
#
# 1) SQL Auth (default): descomenta DB_USER + DB_PASSWORD y deja DB_TRUSTED sin
#    poner o en false. Requiere SQL Server con modo "mixed" habilitado.
# 2) Windows Auth: setea DB_TRUSTED=true y omite DB_USER/DB_PASSWORD. Ideal
#    para SQL Express con autenticación solo-Windows. DB_TRUSTED_DOMAIN es
#    opcional; si lo pones, el driver usa NTLM con ese dominio.
DB_SERVER=localhost\SQLEXPRESS
# Para instancia nombrada, deja DB_PORT sin definir para que SQL Browser resuelva el puerto.
# DB_PORT=1433
DB_NAME=nutriclinica
DB_TRUSTED=true
DB_TRUSTED_USER=
DB_TRUSTED_DOMAIN=
# DB_USER=nutriclinica_app
# DB_PASSWORD=REEMPLAZA_POR_UNA_CONTRASENA_FUERTE
DB_ENCRYPT=false
DB_TRUST_CERT=true
# STAGING/PRODUCTION: DB_ENCRYPT=true y DB_TRUST_CERT=false. La CA/nombre del
# certificado se configura en el host; nunca se debilita la validación.

# --- DWH SQL Server (opcionalmente otra instancia/credencial) ---
# Sin DWH_* de conexión se heredan DB_* pero DWH_DATABASE siempre debe diferir.
DWH_SERVER=
DWH_PORT=
DWH_DATABASE=nutriclinicadw
DWH_TRUSTED=
DWH_TRUSTED_USER=
DWH_TRUSTED_DOMAIN=
DWH_USER=
DWH_PASSWORD=
DWH_ENCRYPT=
DWH_TRUST_CERT=

# --- JWT ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_POR_UN_HEX_DE_64_BYTES_ALEATORIO
JWT_EXPIRES_IN=8h
JWT_ISSUER=nutriclinica-api
JWT_AUDIENCE=nutriclinica-web

# --- Argon2 (password hashing) ---
# memoryCost en KiB. 19456 (19MB) es OWASP m=19.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- CORS ---
# Lista separada por comas. Vite/Tauri dev usa 1420 por defecto.
CORS_ORIGIN=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# --- Field-level encryption ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Si TOTP_ENCRYPTION_KEY no se define, TOTP usa FIELD_ENCRYPTION_KEY y luego JWT_SECRET como fallback.
FIELD_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
# Estable por deployment lineage; cambiarlo invalida valores derivados.
CRYPTO_SALT=nutriclinica-server-v1

# --- SMTP (email notifications) ---
# Fail-closed. STAGING debe permanecer DISABLED o usar un sandbox aprobado.
# El adapter actual solo envía cuando entorno y modo son ambos PRODUCTION.
EXTERNAL_SIDE_EFFECTS_MODE=DISABLED
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nutriclinica.local
EMAIL_FROM_NAME=NutriClínica

# WebRTC server-side ICE config. The endpoint declares OPTIONAL_DIRECT_ALLOWED;
# configured=false permits direct ICE, while configured=true adds a validated
# credentialed relay. Production uses coturn REST ephemeral credentials.
# TURN_SHARED_SECRET is secret and must never use VITE_* or enter an image.
STUN_URLS=
TURN_URLS=
# Static credentials are allowed only for an approved SANDBOX.
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Recording Retention (cleanup automático) ---
# Número de años que deben conservarse las grabaciones cifradas (LFPDPPP + NOM-024: 10 años)
RECORDING_RETENTION_YEARS=10
# Fail-closed: habilitar solo en el workload jobs; dry-run es el default.
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_DRY_RUN=true
RETENTION_LEGAL_HOLD_REVIEW_ATTESTED=false
RETENTION_CLEANUP_BATCH_SIZE=100
# Expresión cron y zona horaria explícita (default: diario 03:00 UTC)
RETENTION_CRON_SCHEDULE=0 3 * * *
RETENTION_CRON_TIMEZONE=UTC

# --- AI provider keys (server-side only) ---
# Nunca expongas estas llaves con prefijo VITE_.
# El egress AI es fail-closed: sin AI_EGRESS_ENABLED=true el API responde 503 y no llama a ningún proveedor.
AI_EGRESS_ENABLED=false
AI_PROVIDER=openai
AI_MODEL_MODE=NUTRICLINICA_LOCAL_AUTO
AI_MODEL_FALLBACK_POLICY=LOCAL_ONLY
AI_ALLOWED_PROVIDERS=openai,ollama
# Allowlist de modelos. Vacío = defaults seguros (gpt-4o-mini, llama3.2) + OPENAI_MODEL/AI_MODEL configurados.
AI_ALLOWED_MODELS=
# Orden de fallback ante fallos operativos (red/5xx/timeout). Las denegaciones de política NO caen a fallback.
AI_FALLBACK_PROVIDERS=openai,ollama
# Circuit breaker por proveedor:modelo. Umbral de fallos consecutivos y cooldown antes de la sonda half-open.
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# Model Evaluation Gate: fail-closed por defecto. Con true, solo sirven modelos certificados para la
# capacidad requerida (chat_general / structured_json / nutrition_reasoning) y con version pineada.
AI_QUALIFICATION_ENFORCED=true
# Version pinning por proveedor (JSON). La version servida DEBE coincidir con el pin configurado.
AI_PINNED_MODEL_VERSIONS={"openai":"gpt-4o-mini","ollama":"llama3.2"}
# ERP Tools: fail-closed por defecto. Requiere AI_TOOLS_ENABLED=true Y la herramienta en AI_TOOLS_ALLOWLIST.
AI_TOOLS_ENABLED=false
AI_TOOLS_ALLOWLIST=
# Clinical Gate: kill switch del expert (fail-closed), shadow mode y umbrales de auto-disable.
AI_EXPERT_ENABLED=false
AI_SHADOW_MODE_ENABLED=false
AI_SHADOW_SAMPLE_RATE=0
AI_CLINICAL_DISAGREEMENT_THRESHOLD=3
AI_CLINICAL_WINDOW_DAYS=7
AI_CLINICAL_REVIEW_STORE=memory
# RAG Gate: conocimiento gobernado (tiers de evidencia, ACL, aprobacion y vigencia).
AI_RAG_DOC_STORE=memory
AI_RAG_VERSIONED=false
RAG_RETRIEVAL_MIN_RECALL=0.6
# AI Memory: contexto auxiliar NO autoritativo con consentimiento y retencion.
AI_MEMORY_ENABLED=false
AI_MEMORY_STORE=memory
AI_MEMORY_RETENTION_DAYS=90
AI_MEMORY_MAX_ENTRIES=50
# DWH / Analytics: historico idempotente, read-only sobre OLTP.
DWH_ENABLED=false
DWH_STORE=memory
DWH_LOAD_WINDOW_DAYS=7
DWH_MAX_FRESHNESS_DAYS=3
DWH_SMALL_CELL_MIN=5
DWH_SCHEDULED_LOAD_ENABLED=false
DWH_CRON_SCHEDULE=30 4 * * *
DWH_CRON_TIMEZONE=UTC
# Solo tests controlados; nunca en STAGING/PRODUCTION normal.
DWH_FAIL_INJECTION=
AI_DWH_NARRATIVE_ENABLED=false
# Patient AI: soporte educativo por token de portal (scope ai_support + consentimiento ai_patient).
AI_PATIENT_ENABLED=false
AI_PATIENT_MAX_QUERY_CHARS=500
# Confirmable Actions: allowlist con preview, confirmacion explicita, idempotencia y rollback.
AI_ACTIONS_ENABLED=false
AI_ACTIONS_LEDGER_STORE=memory
AI_ACTIONS_CONFIRMATION_TTL_MIN=10
AI_ACTIONS_MAX_PENDING_CONFIRMATIONS=10
# Bounded Agents: loops con presupuestos (pasos/tools/tokens/costo/timeout) y revalidacion por paso.
AI_AGENTS_ENABLED=false
AI_AGENTS_LEDGER_STORE=memory
AI_AGENTS_MAX_STEPS=8
AI_AGENTS_MAX_TOOL_CALLS=8
AI_AGENTS_MAX_TOKENS=4096
AI_AGENTS_MAX_COST=1
AI_AGENTS_TIMEOUT_MS=60000
AI_AGENTS_MAX_ACTIVE_RUNS_PER_ACTOR=2
# Future Specialization Gate: especializar modelos solo con evidencia cuantitativa + gobierno.
# AI_SPECIALIZATION_PASS_RATES es JSON {"capability":rate} con resultados de ai:evaluate (0-1).
AI_SPECIALIZATION_ENABLED=false
AI_SPECIALIZATION_STORE=memory
AI_SPECIALIZATION_PASS_RATES=
OPENAI_API_KEY=
# AI_API_KEY=             # fallback generico server-side
# OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.2

# --- AI Data Egress Policy (REMEDIATION BUILD 03) ---
# Cada ejecucion AI declara una capability; su contrato determina categorias de datos,
# allowlist de campos, consentimiento, proposito y residencia. Desconocida = DENY.
# Providers external: PHI y datos clinicos DENY por defecto (fail-closed). Ollama (local)
# pasa por la misma politica: identidad, permisos, consentimiento, allowlist y audit.
# Solo si el operador certifica el provider para datos clinicos se permite PHI externa:
AI_PROVIDER_PHI_ALLOWED_OPENAI=false
AI_PROVIDER_APPROVED_CLINICAL_OPENAI=false
# Residencia declarada del provider ('local' | 'us' | 'eu' | ...). 'unknown' con PHI y
# residencia requerida por la capability = DENY.
AI_PROVIDER_RESIDENCY_OPENAI=unknown
AI_PROVIDER_RETENTION_KNOWN_OPENAI=false
AI_PROVIDER_TRAINING_USE_ALLOWED_OPENAI=false
# --- Deployment identity & operational readiness (REMEDIATION BUILD 09.5A) ---
# Clase de entorno: LOCAL | TEST | STAGING | PRODUCTION.
# Default: LOCAL salvo NODE_ENV=production (=> UNKNOWN, arranque fail-closed).
ENVIRONMENT_CLASS=LOCAL
ENVIRONMENT_NAME=local-development
# api | jobs | migration | dwh-schema; obligatorio fuera de LOCAL/TEST.
WORKLOAD_ROLE=api
# Instancia de despliegue y version de release (trazabilidad del manifiesto /deployment/manifest).
INSTANCE_ID=local-dev-1
DEPLOYMENT_ID=local-dev-1
RELEASE_VERSION=0.0.0-dev
# Commit completo inyectado por el build/deployment driver.
GIT_COMMIT=
# IDs/digests no secretos; STAGING/PRODUCTION requieren sha256 inmutable, nunca latest.
API_ARTIFACT=
API_ARTIFACT_DIGEST=
WEB_ARTIFACT=
WEB_ARTIFACT_DIGEST=
DESKTOP_ARTIFACT=
DESKTOP_ARTIFACT_DIGEST=
# Solo CI puede atestar este valor tras ejecutar el scan de secretos.
SECRET_SCAN_STATUS=
SECRET_SCAN_COMMIT=
SECRET_SCAN_EVIDENCE_ID=
# Evidencia externa; declarar STAGING no implica que esté disponible.
STAGING_AVAILABILITY_ATTESTED=false
STAGING_SMOKE_STATUS=
STAGING_EVIDENCE_ID=
STAGING_EVIDENCE_COMMIT=
# Defaults memory solo para LOCAL/TEST; STAGING/PRODUCTION exigen ambos stores en sql.
# Almacen de certificacion clinica: 'memory' (no persiste) | 'sql' (tablas ai_certification_records
# + ai_requalification_flags, migracion 039). La BD es la fuente de verdad; vacio/ausente = NOT_ELIGIBLE.
AI_CERTIFICATION_STORE=memory
# Telemetría de Build 09: sql para persistencia; nunca PHI crudo.
AI_TELEMETRY_STORE=memory
AI_TELEMETRY_MAX_EVENT_BYTES=2048
AI_TELEMETRY_PERCENTILE_MIN_SAMPLES=5
AI_TELEMETRY_RETENTION_RAW_DAYS=7
AI_TELEMETRY_RETENTION_AGG_DAYS=90
AI_TELEMETRY_RETENTION_ALERT_DAYS=30
AI_TELEMETRY_ALERT_BREAKER_OPENED=true
AI_TELEMETRY_ALERT_SCHEMA_FAILURE_SPIKE=5
AI_TELEMETRY_ALERT_CITATION_VALIDITY_MIN=0.5
AI_TELEMETRY_ALERT_DWH_RECONCILIATION=true
AI_TELEMETRY_ALERT_UNSAFE_EVENT=true
AI_TELEMETRY_ALERT_UNAUTHORIZED_RETRIEVAL=true
AI_TELEMETRY_ALERT_CRITICAL_DISAGREEMENT=1
# Acciones destructivas no rutinarias en STAGING: fail-closed sin ALLOW_STAGING_SEED/RESET/REBUILD/DROP.
# Destruccion de bases en PRODUCTION (migrate/seed/reset/rebuild/drop): fail-closed sin ALLOW_PRODUCTION_*.
# ALLOW_PRODUCTION_MIGRATE=false
# ALLOW_PRODUCTION_DWH_SCHEMA=false
# ALLOW_PRODUCTION_SEED=false
# ALLOW_PRODUCTION_RESET=false
# ALLOW_PRODUCTION_REBUILD=false
# ALLOW_PRODUCTION_DROP=false
# ALLOW_PRODUCTION_MAINTENANCE=false
# Preflight obligatorio para one-shots SQL en STAGING/PRODUCTION.
CHANGE_REQUEST_ID=
BACKUP_RESTORE_ATTESTED=false
ROLLBACK_ARTIFACT_DIGEST=
RETENTION_BACKFILL_APPLY=false
# STAGING/PRODUCTION exigen DB_NAME y DWH_DATABASE explicitos, distintos entre si y de los defaults
# locales (nutriclinica/nutriclinicadw), y CORS_ORIGIN sin comodines.

# --- Shadow pilot (REMEDIATION BUILD 09.5A, piloto 09.5B) ---
# Estado: DISABLED | TECHNICAL_TEST_ONLY | READY_FOR_PROFESSIONAL_SHADOW |
# ACTIVE_PROFESSIONAL_SHADOW | PAUSED | AUTO_DISABLED | COMPLETED.
# Technical = GOLDEN de ingenieria (camino tecnico, nunca clinico). Professional exige
# modelo clínico elegible + consentimiento declarado + revisores + scopes + rollback/backup.
AI_SHADOW_STATE=DISABLED
# SHADOW_TEST_QUALIFIED_PROVIDER=ollama
# SHADOW_TEST_QUALIFIED_MODEL=llama3.2
# AI_STAGING_BASE_URL=https://api-staging.example.invalid
# SHADOW_CONSENT_POLICY=declared_ready
# SHADOW_REVIEWER_KEYS=reviewer-key-1
# SHADOW_REVIEWER_SCOPES=[{"reviewerKey":"reviewer-key-1","role":"nutritionista","capabilities":["nutrition_reasoning"],"sucursalIds":["synthetic-sucursal-id"]}]
# SHADOW_ROLLBACK_VERIFIED=false
# SHADOW_BACKUP_VERIFIED=false
# Contrato del piloto profesional (solo si AI_SHADOW_STATE=READY_FOR_PROFESSIONAL_SHADOW/ACTIVE_PROFESSIONAL_SHADOW):
# SHADOW_PILOT_CAPABILITIES=nutrition_reasoning
# SHADOW_PILOT_RISK_LEVELS=RISK_3
# SHADOW_PILOT_REVIEWER_ROLES=nutritionista
# SHADOW_PILOT_SAMPLING_PERCENT=0.1
# SHADOW_PILOT_MIN_SAMPLE=50
# SHADOW_PILOT_START_AT=2026-09-01T00:00:00Z
# SHADOW_PILOT_END_AT=2026-12-01T00:00:00Z
# SHADOW_PILOT_ZERO_TOLERANCE_UNSAFE=true
# SHADOW_PILOT_ZERO_TOLERANCE_CRITICAL_DISAGREEMENT=true
# SHADOW_PILOT_ZERO_TOLERANCE_SHOULD_HAVE_ABSTAINED=true
# AI_SHADOW_AUTODISABLE_UNSAFE_MAX=0
# AI_SHADOW_AUTODISABLE_CRITICAL_DISAGREEMENT_MAX=0
# AI_SHADOW_AUTODISABLE_SHOULD_HAVE_ABSTAINED_MAX=0
# AI_SHADOW_AUTODISABLE_CITATION_INVALID_MAX=1
# AI_SHADOW_AUTODISABLE_AGREEMENT_MIN=0.6
# AI_SHADOW_AUTODISABLE_MIN_SAMPLES=5

# --- Paths internos del artefacto (normalmente los fija la imagen) ---
# NUTRICLINICA_REPO_ROOT=/app
# NUTRICLINICA_MIGRATIONS_DIR=/app/apps/api/migrations
# NUTRICLINICA_DWH_SCHEMA_FILE=/app/apps/api/dist-deploy/dwh-schema.sql

# --- Windows standalone (server-side only) ---
# The installer writes these values to config/standalone.env. Keep secrets in
# the ACL-protected server-secrets.env file instead of this file.
STANDALONE_MODE=false
STANDALONE_ALLOW_LAN=false
NUTRICLINICA_DATA_ROOT=C:\\ProgramData\\NutriClinica
NUTRICLINICA_BACKUP_ROOT=D:\\NutriClinicaBackups
NUTRICLINICA_LOG_ROOT=C:\\ProgramData\\NutriClinica\\logs
NUTRICLINICA_WEB_ROOT=C:\\Program Files\\NutriClinica\\web
NUTRICLINICA_DOCUMENTS_ROOT=
NUTRICLINICA_RECORDINGS_ROOT=
NUTRICLINICA_DESKTOP_RESTORE_ROOT=

# --- Seed (solo lo usa pnpm seed) ---
# SEED_ADMIN_PASSWORD es obligatoria (el seed aborta sin ella — fail-closed).
# Genera una con: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_EMAIL=admin@nutriclinica.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Administrador General
SEED_SUCURSAL_NOMBRE=Sucursal Centro
