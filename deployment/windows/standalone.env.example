# Non-secret standalone runtime settings. Copy to config/standalone.env.
NODE_ENV=production
ENVIRONMENT_CLASS=LOCAL
STANDALONE_MODE=true
INSTANCE_ID=standalone-host-1
DEPLOYMENT_ID=standalone-host-1
RELEASE_VERSION=0.1.0
GIT_COMMIT=
WORKLOAD_ROLE=api
API_BIND_HOST=127.0.0.1
PORT=3000
PUBLIC_API_URL=http://127.0.0.1:3000
PUBLIC_WEB_URL=http://127.0.0.1:3000
TRUST_PROXY=false
BACKGROUND_JOBS_ENABLED=false
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=nutriclinica
DB_TRUSTED=true
DB_ENCRYPT=false
DB_TRUST_CERT=true
DWH_SERVER=localhost\SQLEXPRESS
DWH_DATABASE=nutriclinicadw
DWH_TRUSTED=true
DWH_ENABLED=true
DWH_STORE=sql
DWH_SCHEDULED_LOAD_ENABLED=true
DWH_CRON_SCHEDULE=30 4 * * *
DWH_CRON_TIMEZONE=UTC
AI_PATIENT_ENABLED=false
AI_SHADOW_STATE=DISABLED
AI_EGRESS_ENABLED=false
AI_MEMORY_ENABLED=false
AI_MEMORY_STORE=sql
AI_RAG_VERSIONED=false
AI_RAG_DOC_STORE=sql
AI_TELEMETRY_STORE=sql
EXTERNAL_SIDE_EFFECTS_MODE=DISABLED
NUTRICLINICA_DATA_ROOT=C:\ProgramData\NutriClinica
NUTRICLINICA_BACKUP_ROOT=D:\NutriClinicaBackups
NUTRICLINICA_LOG_ROOT=C:\ProgramData\NutriClinica\logs
NUTRICLINICA_WEB_ROOT=C:\Program Files\NutriClinica\web
