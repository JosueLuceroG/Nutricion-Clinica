# Variables de entorno (ejemplo)
# Copiar a .env.local y rellenar valores reales

# Entorno
VITE_APP_ENV=development
VITE_APP_NAME=Nutricion Clinica

# API (futuro)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1

# IA (opcional, futuro)
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=openai
VITE_AI_API_KEY=

# Sync
VITE_SYNC_ENABLED=false
VITE_SYNC_INTERVAL_MS=30000

# Sentry (futuro)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
