# Variables de entorno (ejemplo)
# Copiar a .env.local y rellenar valores reales

# Entorno
VITE_APP_ENV=development
VITE_APP_NAME=Nutricion Clinica

# API (futuro)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_API_VERSION=v1

# WebRTC (opcional)
# STUN por defecto: stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_STUN_URLS=
# Ejemplo coturn: turn:turn.tudominio.com:3478,turns:turn.tudominio.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# IA (opcional). La API key vive en apps/api/.env como OPENAI_API_KEY.
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=openai

# --- IA: modo de seleccion de modelo (Build 07.5) ---
# AI_MODEL_MODE=NUTRICLINICA_LOCAL_AUTO | ORGANIZATION_PREFERRED | EXPLICIT_APPROVED_MODEL
# (sin valor -> NUTRICLINICA_LOCAL_AUTO; si existe AI_MODEL/OPENAI_MODEL -> EXPLICIT_APPROVED_MODEL)
# AI_MODEL_MODE=
# Fallback tras abstencion local: LOCAL_ONLY (default, sin cloud silencioso) | LOCAL_PREFERRED_ALLOW_CLOUD
# AI_MODEL_FALLBACK_POLICY=LOCAL_ONLY
# Runtime local (Ollama) si no esta en el default:
# OLLAMA_BASE_URL=http://localhost:11434
# Credenciales API (server-side only, nunca en el cliente):
# OPENAI_API_KEY=sk-...
# AI_API_KEY=sk-...   (alternativa generica)

# Sync
VITE_SYNC_ENABLED=false
VITE_SYNC_INTERVAL_MS=30000

# Sentry (futuro)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
