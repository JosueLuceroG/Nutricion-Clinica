# Variables de entorno (ejemplo)
# Copiar a .env.local y rellenar valores reales

# API pública. Es la única fuente usada por los clientes.
# Web container usa /api (same-origin); Desktop release usa HTTPS absoluto.
VITE_API_URL=http://localhost:3000

# WebRTC obtiene STUN/TURN desde el endpoint autenticado de la API.
# No se incluyen credenciales ICE en variables VITE_* ni en el bundle.

# IA (opcional). La API key vive en apps/api/.env como OPENAI_API_KEY.
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=openai

# Model routing, provider URLs and API keys are server-side only; see
# apps/api/.env.example. Never add them with a VITE_* prefix.

# Standalone Web builds use VITE_API_URL=/api. The Windows service reads its
# server-side endpoint and secrets from the protected installation config.
